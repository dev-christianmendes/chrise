# mock = demo pública (dados fictícios no navegador) | supabase = produção
VITE_DATA_SOURCE=mock

# Só para VITE_DATA_SOURCE=supabase. A anon key é pública por design; a segurança vem do RLS.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Chave pública VAPID para Web Push. A privada fica apenas nos secrets do Supabase.
VITE_VAPID_PUBLIC_KEY=
